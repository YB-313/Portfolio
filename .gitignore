# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ===== Virtual environments =====
.venv/
venv/
env/
ENV/
.env               # secrets / API keys — NEVER commit
.env.*

# ===== Jupyter Notebook =====
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ===== Data files =====
# Small SAMPLE datasets used by projects are committed on purpose (e.g. data/*.csv).
# But keep large / raw / private data OUT of git. Adjust to taste:
data/raw/          # drop big raw downloads here — ignored by default
*.parquet
*.feather
*.h5
*.hdf5
*.sqlite
*.sqlite3
*.db
# Uncomment the next lines if a dataset is too big or private to commit:
# *.csv
# *.xlsx

# ===== Notebooks / analysis output you don't want tracked =====
*.log

# ===== OS / editor cruft =====
.DS_Store
Thumbs.db
desktop.ini        # created by Windows / OneDrive
.vscode/
.idea/

# ===== Claude Code local config =====
.claude/
roadmap.md
